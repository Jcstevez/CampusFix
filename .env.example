# Copiar a .env (NO se versiona). Ver docs/implementacion.md para el detalle.
PORT=8080
# H2 en memoria (se pierde al reiniciar). Para persistir en el volumen /data:
# JDBC_URL=jdbc:h2:file:/data/campusfix;AUTO_SERVER=FALSE
JDBC_URL=jdbc:h2:mem:campusfix;DB_CLOSE_DELAY=-1
CORREO_TI=soporte-ti@unisabana.edu.co
CORREO_MANTENIMIENTO=mantenimiento@unisabana.edu.co
